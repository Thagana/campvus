# Bare "node_modules" only reliably excludes the top-level directory in
# practice (verified: apps/mode-b-web/node_modules — including a broken
# @campvus/design symlink pointing at an absolute host path from local dev
# — was still landing in the build context and clobbering the correct one
# `pnpm install` creates inside the container, since COPY apps/mode-b-web
# apps/mode-b-web runs after the install step). "**/node_modules" is the
# unambiguous form.
**/node_modules
.git
.scratch

# Local dev runtime state — must never be baked into the image (this would
# ship a real institution private key and a dev's uploaded content in every
# build). Production generates its own on first boot into the mounted
# volume — see apps/mode-b-api/src/paths.ts (DATA_DIR).
apps/mode-b-api/data
apps/mode-b-api/content-store
apps/mode-b-api/registry.json
apps/mode-b-api/institution-keys.json

# Rebuilt fresh in the builder stage; a stale local build shouldn't leak in.
apps/mode-b-web/dist

# Not part of this image (Mode A only).
apps/mode-a-desktop
apps/mode-a-headless
apps/campvus

Dockerfile
.dockerignore
fly.toml
**/*.log
