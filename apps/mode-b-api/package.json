{
  "name": "@campvus/mode-b-api",
  "version": "1.0.0",
  "private": true,
  "description": "Mode B: the full-app backend — direct-upload API, auth/enrollment, and origin storage. We deploy this infra ourselves instead of watching an LMS.",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "create-school": "tsx --env-file-if-exists=.env src/scripts/create-school.ts",
    "test": "tsx --env-file-if-exists=.env --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@campvus/engine": "workspace:*",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
