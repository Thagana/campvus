BETTER_AUTH_URL=http://localhost:3000

# Postgres connection string (db/client.ts). Required to boot the server,
# run `pnpm create-school`, or apply the DDL.
DATABASE_URL=postgresql://user:password@localhost:5432/campvus

# Points the test suite (test/helpers.ts) at a disposable Postgres instance
# it can freely CREATE/DROP databases on — never point this at DATABASE_URL
# above or any real deployment's database.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/postgres

# Origin the accept-invite link points at (mode-b-web's dev server by
# default). Doesn't send yet — the invite link is only printed to the
# server console (see auth.ts's sendInvitationEmail) until /accept-invite
# exists in mode-b-web.
WEB_URL=http://localhost:5173

# Brevo (https://developers.brevo.com/docs/getting-started) sends the
# register-verification and forgot-password emails. Without a real
# BREVO_API_KEY, those emails are logged to the console instead of sent.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@example.com
BREVO_FROM_NAME=Campvus
BREVO_LOG_SUCCESS=1
